<idea-plugin>
  <id>ww97951807.claude-sessions</id>
  <name>Claude Sessions</name>
  <vendor>ww979951807</vendor>
  <description>Claude session list tool window: sessions of the current project, double click to resume, green dot for open tabs.</description>
  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.terminal</depends>
  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="Claude Sessions" anchor="left" order="after Version Control" icon="/icons/rebased/claudeSessions.svg"
                showStripeButton="true" factoryClass="org.jetbrains.plugins.terminal.claude.ClaudeSessionsToolWindowFactory"/>
  </extensions>
  <actions>
    <!-- Terminal.CopySelectedText is grey in Claude session tabs: the Reworked engine keeps
         the selection in the frontend TerminalView, not the popup-time editor selection the
         stock action checks. Override it with a copy that reads the terminal selection model
         and falls back to the stock behaviour elsewhere. -->
    <action id="Terminal.CopySelectedText"
            class="org.jetbrains.plugins.terminal.claude.ClaudeTerminalCopyAction"
            icon="AllIcons.Actions.Copy"/>
  </actions>
</idea-plugin>
